{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "resolveJsonModule": true, "esModuleInterop": true,
    "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.mjs"]
}
